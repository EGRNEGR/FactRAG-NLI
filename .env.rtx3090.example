# Профиль RTX 3090 (24 ГБ) под Linux. scripts/linux/setup.sh копирует его в .env и генерирует
# RAG_API_TOKENS. Пороги верификатора и поиска совпадают с .env.example (калибровка на dev-половине
# eval_dataset_v3); изменены только аппаратные параметры. Модель LLM, реранкер, окно контекста и
# батчи задаёт scripts/linux/env.rtx3090.sh через переменные окружения - они важнее этого файла.
RAG_MODE=production
RAG_ALLOW_FALLBACK=false
RAG_EMBEDDING_MODEL_PATH=models/bge-m3
RAG_RERANKER_MODEL_PATH=models/bge-reranker-v2-m3
RAG_NLI_MODEL_PATH=models/mdeberta-nli
RAG_LLM_MODEL_PATH=models/llm/Qwen3.8-27B-UD-Q4_K_XL.gguf
# Qwen3.x по умолчанию думает (<think>); ответ RAG нужен без рассуждений.
RAG_LLM_DISABLE_THINKING=true
RAG_LLM_BACKEND=vllm
RAG_LLM_API_BASE=http://127.0.0.1:8080/v1
RAG_DOCUMENT_ROOT=data/documents
RAG_QDRANT_PATH=data/qdrant
# JSON-массив независимых секретов длиной не менее 32 символов, например:
# python -c "import json, secrets; print(json.dumps([secrets.token_urlsafe(48)]))"
RAG_API_TOKENS=
RAG_MAX_UPLOAD_FILE_SIZE_MB=100
# 24 ГБ: llama-server с Qwen3.8-27B занимает ~18 ГБ, кодировщикам хватает батчей 16/8.
RAG_EMBEDDING_BATCH_SIZE=16
RAG_RERANK_BATCH_SIZE=8
RAG_DENSE_CANDIDATES=60
RAG_SPARSE_CANDIDATES=60
# 10 чанков в контексте LLM (A/B на Qwen3.8: 37 из 40 верно против 28 при 5).
RAG_RERANK_TOP_K=10
RAG_LLM_CONTEXT_WINDOW=8192
RAG_LLM_TOKENIZER_MODE=llama_server
RAG_CHUNK_TARGET_TOKENS=320
RAG_CHUNK_MAX_TOKENS=384
RAG_LLM_API_TIMEOUT=300
# Гибридный поиск. Пороги подобраны на dev-половине eval_dataset_v3 (evaluate_suite.dataset_split),
# test-половина отчитывается отдельно. Итоговый балл = alpha * RRF + (1 - alpha) * rerank:
# при alpha 0.2 порядок определяет кросс-энкодер, RRF лишь разводит близкие баллы.
RAG_RRF_K=30
RAG_RERANK_CANDIDATES=40
RAG_RERANK_RRF_ALPHA=0.2
# Гейт по лучшему чанку (top): порог решает только отказ, в LLM уходят top_k чанков по рангу.
# 0.02 для bge-reranker-v2-m3 выбран на dev-половинах v3 и XQuAD (docs/RTX3090_LINUX.md, раздел 5).
RAG_RERANK_GATE_SCOPE=top
RAG_RERANK_SCORE_THRESHOLD=0.02
# Вес BM25 умножается на долю терминов запроса, найденных в словаре индекса: русский вопрос
# к англоязычному RFC почти не даёт лексического сигнала и не должен вытеснять dense-кандидатов.
RAG_SPARSE_COVERAGE_WEIGHTING=true
# Верификатор (значения совпадают с умолчаниями settings.py; обоснование и абляция -
# reports/EVALUATION_REPORT.md). Базовое правило для целого чанка:
RAG_NLI_ENTAILMENT_THRESHOLD=0.4
RAG_NLI_CONTRADICTION_THRESHOLD=0.2
RAG_NLI_STRONG_ENTAILMENT_THRESHOLD=0.7
RAG_NLI_PRECISION=float16
RAG_NLI_BATCH_SIZE=16
# Сегментация v2 не режет утверждение на сокращениях (Rev. 5, e.g., No. 1) и на ";";
# предложение без [S#] наследует ссылку соседнего предложения того же абзаца.
RAG_CLAIM_SEGMENTATION=v2
RAG_CLAIM_CITATION_INHERITANCE=true
# Посылка без заголовка, HTML-разметки и сущностей; окна по 1-2 предложения чанка.
RAG_NLI_PREMISE_CLEANUP=true
RAG_NLI_WINDOW_SCORING=true
RAG_NLI_WINDOW_SENTENCES=2
RAG_NLI_WINDOW_ENTAILMENT_THRESHOLD=0.8
RAG_NLI_WINDOW_CONTRADICTION_THRESHOLD=0.05
# Числа, коды и идентификаторы утверждения обязаны встречаться в процитированном чанке;
# окно, содержащее их все, принимается при более мягких порогах.
RAG_NLI_ANCHOR_GUARD=true
RAG_NLI_ANCHOR_WINDOWS=true
RAG_NLI_ANCHOR_WINDOW_ENTAILMENT_THRESHOLD=0.4
RAG_NLI_ANCHOR_WINDOW_CONTRADICTION_THRESHOLD=0.2
# Дословный фрагмент синтаксиса (ABNF, флаги, присваивания) длиной от N символов.
RAG_NLI_CODE_SPAN_MIN_CHARS=12
# Одного уверенно подтверждающего источника достаточно; другой процитированный источник
# блокирует утверждение, только если явно противоречит ему (P(contradiction) >= veto).
RAG_NLI_AGGREGATION=support_first
RAG_NLI_VETO_CONTRADICTION_THRESHOLD=0.9
# Утверждения об отсутствии сведений публикуются как оговорка и не считаются заблокированными;
# исправление предпосылки вопроса не публикуется без подтверждённого обоснования.
RAG_ABSTENTION_GUARD=true
# Название документа (читается из головы исходного файла) и раздела - дополнительный вариант
# каждой посылки NLI; LLM его не видит, переиндексация не нужна.
RAG_NLI_PREMISE_TITLE=true
# Совместная проверка: UNVERIFIED-утверждение публикуется, если другое утверждение ответа
# VERIFIED по общему источнику, а все числа, идентификаторы и не меньше доли слов есть в нём.
RAG_NLI_CO_VERIFICATION=true
RAG_NLI_CO_VERIFICATION_OVERLAP=0.5
# Гипотеза NLI без вводного «Нет,» перед исправлением (Qwen3.8 так начинает поправки).
RAG_NLI_STRIP_VERDICT_PREFIX=true
RAG_NLI_EVIDENCE_FOCUS=false
# Одна повторная генерация, если NLI отклонил ответ: LLM получает отклонённые утверждения и
# сужает ответ до подтверждаемых фактов (пилот на dev: меньше ложных отказов, без новых галлюцинаций).
RAG_GENERATION_REPAIR_ATTEMPTS=1
RAG_GENERATION_LANGUAGE=ru
RAG_MAX_TOKENS=512
